# Prioritaire. Clé Map Tiles API, restreinte par referrer HTTP.
# Si elle est renseignée, le globe charge les tuiles 3D photoréalistes Google.
VITE_GOOGLE_MAPS_API_KEY=

# Facultatif. Utilisé seulement sans clé Google.
# Vide : le jeton Cesium ion livré avec CesiumJS (offre Community du paquet).
# Renseignez le jeton de votre compte https://ion.cesium.com pour votre propre quota.
VITE_CESIUM_ION_TOKEN=

# Laisser vide pour utiliser l'API locale du serveur de développement (/api/v1).
VITE_API_BASE=
